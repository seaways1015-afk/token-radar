{
  "name": "token-radar",
  "version": "0.2.0",
  "description": "自动发现本机 AI 编程工具，实时监控 token 消耗、费用与订阅额度的桌面应用",
  "author": "seaways1015-afk",
  "homepage": "https://github.com/seaways1015-afk/token-radar",
  "repository": {
    "type": "git",
    "url": "https://github.com/seaways1015-afk/token-radar.git"
  },
  "bugs": {
    "url": "https://github.com/seaways1015-afk/token-radar/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js --open",
    "assets": "electron scripts/render-assets.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "claude-code",
    "codex",
    "token",
    "usage",
    "monitor",
    "electron",
    "dashboard"
  ],
  "build": {
    "appId": "com.tokenradar.app",
    "productName": "Token Radar",
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TokenRadar-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TokenRadar-${version}-portable.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "seaways1015-afk",
      "repo": "token-radar",
      "releaseType": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "TokenRadar-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "artifactName": "TokenRadar-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0"
  }
}
