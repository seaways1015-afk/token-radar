{
  "name": "token-radar",
  "version": "0.1.0",
  "description": "实时监控 Claude Code / Codex 的 token 消耗、费用与订阅额度的桌面应用",
  "author": "seaways1015-afk",
  "homepage": "https://github.com/seaways1015-afk/token-radar",
  "repository": {
    "type": "git",
    "url": "https://github.com/seaways1015-afk/token-radar.git"
  },
  "bugs": {
    "url": "https://github.com/seaways1015-afk/token-radar/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "node server/index.js --open",
    "assets": "electron scripts/render-assets.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "claude-code",
    "codex",
    "token",
    "usage",
    "monitor",
    "electron",
    "dashboard"
  ],
  "build": {
    "appId": "com.tokenradar.app",
    "productName": "Token Radar",
    "files": [
      "electron/**",
      "server/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TokenRadar-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TokenRadar-${version}-portable.exe"
    }
  }
}
